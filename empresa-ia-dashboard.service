[Unit]
Description=My AI Office - dashboard do escritorio (http://127.0.0.1:8770)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/empresa-ia
Environment=PATH=%h/.local/share/mise/shims:%h/.local/bin:/usr/local/bin:/usr/bin
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m empresa servir
Nice=10
Restart=always
RestartSec=5
StandardOutput=append:%h/empresa-ia/var/dashboard.log
StandardError=append:%h/empresa-ia/var/dashboard.log

[Install]
WantedBy=default.target
